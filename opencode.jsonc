{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "mlx": {
      "name": "MLX Local",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "devstral-small-2-24b-instruct-4bit": {
          "name": "Devstral Small 2 24B Instruct 4-bit",
          "limit": {
            "context": 4096,
            "output": 2048
          }
        }
      }
    }
  }
}